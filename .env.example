# ==== 大模型配置（任何兼容 OpenAI 接口的服务均可，示例为 DeepSeek）====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在此填入你的密钥
LLM_MODEL=deepseek-chat

# ==== 可选配置（留空使用默认值）====
# 单次请求超时秒数
LLM_TIMEOUT_SECONDS=60
# 网络类错误自动重试次数
LLM_MAX_RETRIES=3
# 单轮对话最大工具调用次数（防无限循环）
MAX_TOOL_CALLS_PER_TURN=8
# 对话历史最多保留的消息条数
MAX_HISTORY_MESSAGES=60
# 确认模式：always=控制类操作必须人工确认（默认，安全）；never=跳过确认，仅限调试
CONFIRMATION_MODE=always
# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# ==== 设备后端 ====
# simulated=内置模拟设备（默认，安全，无需任何外部服务）
# homeassistant=接入真实 Home Assistant（需先完成部署，见 docs/RUNBOOK.md）
DEVICE_BACKEND=simulated
# Home Assistant 地址与长期访问令牌（HA 网页 → 用户资料 → 安全 → 创建令牌）
HA_URL=http://localhost:8123
HA_TOKEN=
# 请求 HA 的超时秒数
HA_TIMEOUT_SECONDS=10
# 设备白名单：从 config/ha_devices.example.json 复制为 config/ha_devices.json 后修改

# ==== 主动服务 ====
# 后台检查间隔秒数（提醒不再依赖你说话；单条规则还有独立的冷却期防轰炸）
PROACTIVE_CHECK_INTERVAL_SECONDS=60

# ==== 多模型（可选）：一个主模型 + 若干次级模型 ====
# 每个角色一组 LLM_<角色>_* 变量，未定义的字段自动继承上方全局 LLM_*；
# 一个都不配置时所有角色共用全局模型（行为与单模型完全一致）。
# 内置角色绑定：main=对话主模型（Agent）；planner=多步任务规划（PlanRunner）；
# 其他名字可自取（小写字母/数字/下划线），供新增消费者使用。
# 示例 1：给任务规划换一个不同的模型（API_KEY 留空则沿用全局 LLM_API_KEY）
# LLM_PLANNER_MODEL=glm-4-flash
# LLM_PLANNER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_PLANNER_API_KEY=
# 示例 2：新增任意次级模型（如意图分类、摘要等未来消费者）
# LLM_CHEAP_MODEL=deepseek-chat
# LLM_CHEAP_BASE_URL=https://api.deepseek.com
# LLM_CHEAP_API_KEY=sk-xxx

