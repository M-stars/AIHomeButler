# 复制为 firmware/esphome/secrets.yaml 并填入真实值（secrets.yaml 已被 gitignore，不会提交）
wifi_ssid: "你家WiFi名称"
wifi_password: "你家WiFi密码"
# 生成 32 字节 base64 密钥：esphome 会提示，或用 python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "在此粘贴32字节base64密钥"
ota_password: "设置一个OTA更新密码"
